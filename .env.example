# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY. Used by app/actions/public-forms.ts
# to save form submissions after the reCAPTCHA check. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# reCAPTCHA (Google Cloud). Site key: a score-based "Website" key.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Google Cloud project ID that owns the key, and an API key restricted to the
# reCAPTCHA Enterprise API — SERVER ONLY.
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
