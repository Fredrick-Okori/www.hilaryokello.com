
# WhatsApp Business (Meta Cloud API) — SERVER ONLY. Sends booking confirmations
# from the booking number. Leave empty to save bookings without messaging.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with body variables {{1}} name, {{2}} event type, {{3}} date.
WHATSAPP_BOOKING_TEMPLATE=booking_received
WHATSAPP_TEMPLATE_LANGUAGE=en
